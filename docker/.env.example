# Image registry + versions for the demo stack.
# Copy to .env and override as needed: `cp .env.example .env`.
# These defaults match the values inlined in the compose files, so the stack
# runs without a .env at all. Defaults pull rolling tags from Gravitee's ACR
# (private — needs `az acr login --name graviteeio`), so docs don't churn per build.

# # Registry prefix for all Gravitee images. Default is the private ACR.
# REGISTRY=graviteeio.azurecr.io

# # APIM backend (apim-management-api, apim-gateway) — debian variant
# APIM_BACKEND_VERSION=4.12.x-latest-debian

# # APIM UIs (apim-management-ui, apim-portal-ui)
# APIM_UI_VERSION=4.12.x-latest

# # Gamma console (gamma-ui)
# GAMMA_VERSION=4.12.x-latest

# # Access Management (am-management-api, am-gateway, am-management-ui)
# # Note: AM has no 4.12.x line on ACR yet — master-latest is the rolling tag.
# AM_VERSION=master-latest

# ── Public Docker Hub instead of ACR ────────────────────────────
# The public hub (graviteeio/*) has no rolling 4.12 alpha tags, so pin explicitly.
# Uncomment to pull published alphas with no ACR login (APIM backend lands shortly):
# REGISTRY=graviteeio
# APIM_BACKEND_VERSION=4.12.0-alpha.1
# APIM_UI_VERSION=4.12.0-alpha.1
# GAMMA_VERSION=4.12.0-alpha.1
# AM_VERSION=4.12.0-alpha.4

# ── Tavily MCP server ────────────────────────────────────────────
# API key used to authenticate against the Tavily remote MCP server.
# Get yours at https://app.tavily.com
# TAVILY_API_KEY=
# TAVILY_MCP_ENDPOINT=https://mcp.tavily.com/mcp/